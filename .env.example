# Token do @BotFather cấp. Không commit token thật.
TELEGRAM_BOT_TOKEN=

# Chỉ những chat ID này mới được phép chạy lệnh.
TELEGRAM_ALLOWED_CHAT_IDS=

TELEGRAM_JOB_TIMEOUT_SEC=7200
TELEGRAM_AUTO_SEND_FILES=0
TELEGRAM_MAX_FILES=3

# DeepSeek API key để bật DeepSeek Harness agent.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-v4-flash
DSH_MAX_TOKENS=32768
DSH_REQUEST_TIMEOUT_SEC=7200
DSH_PROVIDER=deepseek-official
